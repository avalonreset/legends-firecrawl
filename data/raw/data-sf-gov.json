    {
      "id": "data-sf-gov/open-data/datasets",
      "provider": "data-sf-gov",
      "capability": "open-data/datasets",
      "name": "Datasets",
      "description": "Start here when the 4x4 dataset id is unknown: find the dataset, then call `dataset` for its columns and `rows` for its data. Only results with type `dataset` (and a non-null api_url) have rows.",
      "creditsCost": 5,
      "perRecord": false,
      "options": [
        {
          "name": "category",
          "type": "string",
          "in": "body",
          "about": "Exact portal category as returned by `facets` (for example `Housing and Buildings`)."
        },
        {
          "name": "cursor",
          "type": "string",
          "in": "body",
          "about": "Opaque `next_cursor` from the previous page; send it with the same search parameters."
        },
        {
          "name": "dataset_id",
          "type": "string",
          "in": "body",
          "about": "Look up one asset by 4x4 id (for example `3i4a-hu95`) or by a data.sf.gov / data.sfgov.org URL containing it. Unknown ids are not_found."
        },
        {
          "name": "limit",
          "type": "number",
          "in": "body",
          "about": "Results per page (1-100).",
          "default": 20,
          "min": 1,
          "max": 100
        },
        {
          "name": "only",
          "type": "string",
          "in": "body",
          "about": "Restrict to one asset type. `datasets` are the tabular assets that `rows` can query.",
          "oneOf": [
            "datasets",
            "maps",
            "filters",
            "charts",
            "hrefs",
            "files",
            "stories",
            "measures",
            "visualizations"
          ]
        },
        {
          "name": "order",
          "type": "string",
          "in": "body",
          "about": "Sort order. `relevance` (default) needs a `query`; the others are descending except `name`.",
          "default": "relevance",
          "oneOf": [
            "relevance",
            "updatedAt",
            "createdAt",
            "name",
            "page_views_total",
            "page_views_last_month",
            "page_views_last_week",
            "download_count"
          ]
        },
        {
          "name": "query",
          "type": "string",
          "in": "body",
          "about": "Free-text search over names, descriptions, tags and columns, for example `zoning` or `building permits`."
        },
        {
          "name": "tags",
          "type": "string[]",
          "in": "body",
          "about": "Portal tags as returned by `facets`; an asset must carry all of them."
        }
