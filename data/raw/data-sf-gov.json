{
  "id": "data-sf-gov",
  "provider": "data-sf-gov",
  "name": "DataSF open data portal",
  "description": "San Francisco's open data portal (data.sf.gov, a Socrata site): search the dataset catalog, read a dataset's metadata and columns, query and count rows of any dataset with SoQL ($select/$where/$order/$group/$q and bare field filters, including spatial functions), and list the portal's category and tag facets.",
  "toolCount": 5,
  "next": {
    "provider": "firecrawl",
    "capability": "find-tools",
    "options": {
      "level": "tools",
      "limit": 100,
      "offset": 0,
      "providers": [
        "data-sf-gov"
      ]
    }
  },
  "tools": [
    {
      "id": "data-sf-gov/open-data/dataset",
      "provider": "data-sf-gov",
      "capability": "open-data/dataset",
      "name": "Dataset",
      "description": "Before `rows`: column field names and datatypes must come from here, not be guessed. Accepts a 4x4 id or any data.sf.gov / data.sfgov.org dataset URL.",
      "creditsCost": 5,
      "perRecord": false,
      "options": [
        {
          "name": "dataset_id",
          "type": "string",
          "in": "body",
          "about": "4x4 id (for example `3i4a-hu95`) or a portal URL containing it: https://data.sf.gov/d/<id>, .../<Category>/<Name>/<id>, .../resource/<id>.json (data.sfgov.org accepted).",
          "required": true
        }
      ],
      "response": {
        "about": "Metadata and the column list of one DataSF asset from /api/views/<4x4>.json: name, description, category, tags, attribution, license, provenance, creation/update timestamps, publishing department and frequency, custom metadata fields, and every column with its SoQL field_name (which can differ from the display name and may be truncated to 10 characters on legacy imports), datatype (text, number, calendar_date, point, multipolygon ...), description and cached value statistics (counts and top values). Also returns the landing source_url and the SODA api_url. Unknown ids are not_found.",
        "key": "",
        "paginated": false,
        "fields": [
