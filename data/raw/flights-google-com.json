{
  "id": "flights-google-com",
  "provider": "flights-google-com",
  "name": "Google Flights",
  "description": "Google Flights airport/city lookup and one-way or two-step round-trip fare search.",
  "toolCount": 2,
  "next": {
    "provider": "firecrawl",
    "capability": "find-tools",
    "options": {
      "level": "tools",
      "limit": 100,
      "offset": 0,
      "providers": [
        "flights-google-com"
      ]
    }
  },
  "tools": [
    {
      "id": "flights-google-com/flights/search_flights",
      "provider": "flights-google-com",
      "capability": "flights/search_flights",
      "name": "Search flights",
      "description": "Search Google Flights one-way fares or round-trip outbound options. For matching returns, call again with a chosen selection in selected_outbound. Round-trip outbound prices are starting prices; return prices cover the selected pair. Bounded first-page coverage, without retries or pagination.",
      "creditsCost": 5,
      "perRecord": false,
      "options": [
        {
          "name": "adults",
          "type": "number",
          "in": "body",
          "about": "adults",
          "default": 1,
          "min": 1,
          "max": 9
        },
        {
          "name": "cabin_class",
          "type": "string",
          "in": "body",
          "about": "cabin_class",
          "default": "economy",
          "oneOf": [
            "economy",
            "premium_economy",
            "business",
            "first"
          ]
        },
        {
          "name": "children",
          "type": "number",
          "in": "body",
          "about": "At most 9 passengers total. Infants are not supported.",
          "default": 0,
          "min": 0,
          "max": 8
        },
        {
          "name": "currency",
          "type": "string",
          "in": "body",
          "about": "Pattern: ^[A-Z]{3}$.",
          "default": "USD"
        },
        {
          "name": "departure_date",
          "type": "string",
          "in": "body",
          "about": "departure_date"
        },
        {
          "name": "destination",
          "type": "string",
          "in": "body",
          "about": "Airport IATA code or Google city id returned by suggest_places. Pattern: ^(?:[A-Z]{3}|/(?:m|g)/[A-Za-z0-9_]{1,60})$.",
          "required": true
        },
        {
          "name": "limit",
          "type": "number",
          "in": "body",
          "about": "Maximum rows from Google’s first results page, in its ranked order. Not pagination.",
          "default": 10,
          "min": 1,
          "max": 50
        },
        {
          "name": "market",
          "type": "string",
          "in": "body",
          "about": "Display/sales market; does not change the proxy country. Pattern: ^[A-Z]{2}$.",
          "default": "US"
        },
        {
          "name": "max_stops",
          "type": "number",
          "in": "body",
          "about": "max_stops"
        },
        {
          "name": "origin",
          "type": "string",
          "in": "body",
          "about": "Airport IATA code or Google city id returned by suggest_places. Pattern: ^(?:[A-Z]{3}|/(?:m|g)/[A-Za-z0-9_]{1,60})$.",
          "required": true
        },
        {
          "name": "return_date",
          "type": "string",
          "in": "body",
          "about": "return_date"
        },
        {
          "name": "selected_outbound",
          "type": "object[]",
          "in": "body",
          "about": "For return options, copy a flight’s selection array from the outbound search and keep the original trip parameters. Requires return_date. No session/cursor token."
        }
      ],
      "response": {
        "about": "Search Google Flights one-way fares or round-trip outbound options. For matching returns, call again with a chosen selection in selected_outbound. Round-trip outbound prices are starting prices; return prices cover the selected pair. Bounded first-page coverage, without retries or pagination.",
        "key": "",
        "paginated": false,
        "fields": [
          {
            "name": "available_results",
            "type": "number"
          },
          {
            "name": "continuation",
            "type": "object"
          },
          {
            "name": "coverage",
            "type": "string"
          },
          {
            "name": "flights",
            "type": "object[]"
          },
          {
            "name": "notices",
            "type": "string[]",
            "about": "Google’s own coverage notices for this search, e.g. “Google Flights has limited flight results on this route”. Empty when Google shows none; when present the result is also reported as partial coverage in meta. Flights not distributed to Google (tour-operator charters, some sanctioned carriers) never appear here."
          },
          {
            "name": "observed_at_ms",
            "type": "number"
          },
          {
            "name": "price_scope",
            "type": "string"
          },
          {
            "name": "query",
            "type": "object"
          },
          {
            "name": "returned",
            "type": "number"
          },
          {
            "name": "search_url",
            "type": "string"
          },
          {
            "name": "selected_outbound",
            "type": "object"
          },
          {
            "name": "stage",
            "type": "string"
          },
          {
            "name": "truncated",
            "type": "boolean"
          }
        ]
      },
      "example": {
        "request": {
          "destination": "LAX",
          "limit": 2,
          "origin": "JFK"
        },
        "response": {
