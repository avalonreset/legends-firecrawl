    {
      "id": "npiregistry-cms-hhs-gov/providers/search",
      "provider": "npiregistry-cms-hhs-gov",
      "capability": "providers/search",
      "name": "Search",
      "description": "Search the CMS NPPES NPI Registry for healthcare providers (individuals or organizations) by name, organization, taxonomy/specialty, city, state, postal code or country. Returns one page (limit 1-200, skip up to 1200) of full provider records: NPI, taxonomies with licenses, mailing and practice addresses, other names, payer identifiers and endpoints. Requires at least one of first_name, last_name, organization_name, taxonomy_description or postal_code.",
      "creditsCost": 5,
      "perRecord": false,
      "options": [
        {
          "name": "address_purpose",
          "type": "string",
          "in": "body",
          "about": "Which address the city/state/postal_code filters apply to. Default: any.",
          "oneOf": [
            "location",
            "mailing",
            "primary",
            "secondary"
          ]
        },
        {
          "name": "city",
          "type": "string",
          "in": "body",
          "about": "City of the mailing or practice address. Up to 100 ASCII characters (NPPES rejects accented letters; O'Brien, Smith-Jones and St. John are fine); one trailing `*` wildcard is allowed after at least two characters."
        },
        {
          "name": "country_code",
          "type": "string",
          "in": "body",
          "about": "Two-letter country code; US is the default in NPPES. Pattern: ^[A-Za-z]{2}$."
        },
        {
          "name": "enumeration_type",
          "type": "string",
          "in": "body",
          "about": "individual (NPI-1) or organization (NPI-2). Omit for both.",
          "oneOf": [
            "individual",
            "organization"
          ]
        },
        {
          "name": "first_name",
          "type": "string",
          "in": "body",
          "about": "Individual provider first name (NPI-1 only). Up to 100 ASCII characters (NPPES rejects accented letters; O'Brien, Smith-Jones and St. John are fine); one trailing `*` wildcard is allowed after at least two characters."
        },
        {
          "name": "last_name",
          "type": "string",
          "in": "body",
          "about": "Individual provider last name (NPI-1 only). Up to 100 ASCII characters (NPPES rejects accented letters; O'Brien, Smith-Jones and St. John are fine); one trailing `*` wildcard is allowed after at least two characters."
        },
        {
          "name": "limit",
          "type": "number",
          "in": "body",
          "about": "Records per page.",
          "default": 10,
          "min": 1,
          "max": 200
        },
        {
          "name": "organization_name",
          "type": "string",
          "in": "body",
          "about": "Organization legal name or other name (NPI-2 only); also matches Doing Business As names. Up to 100 ASCII characters (NPPES rejects accented letters; O'Brien, Smith-Jones and St. John are fine); one trailing `*` wildcard is allowed after at least two characters."
        },
        {
          "name": "postal_code",
          "type": "string",
          "in": "body",
          "about": "5- or 9-digit ZIP, or a prefix followed by `*` (e.g. 941*)."
        },
        {
          "name": "skip",
          "type": "number",
          "in": "body",
          "about": "Records to skip; pass next_skip from the previous page. NPPES allows at most 1200.",
          "default": 0,
          "min": 0,
          "max": 1200
        },
        {
          "name": "state",
          "type": "string",
          "in": "body",
          "about": "Two-letter US state/territory code. Needs another criterion. Pattern: ^[A-Za-z]{2}$."
        },
        {
          "name": "taxonomy_description",
          "type": "string",
          "in": "body",
          "about": "Specialty / taxonomy description such as Cardiology, Dermatology, Family Medicine, Hospice Care, Community Based, or a taxonomy code like 208800000X. Up to 100 ASCII characters (NPPES rejects accented letters; O'Brien, Smith-Jones and St. John are fine); one trailing `*` wildcard is allowed after at least two characters."
        },
        {
          "name": "use_first_name_alias",
          "type": "boolean",
          "in": "body",
          "about": "Also match common first-name aliases (Bob for Robert). Requires first_name. NPPES default is true."
        }
      ],
      "response": {
        "about": "Search the CMS NPPES NPI Registry for healthcare providers (individuals or organizations) by name, organization, taxonomy/specialty, city, state, postal code or country. Returns one page (limit 1-200, skip up to 1200) of full provider records: NPI, taxonomies with licenses, mailing and practice addresses, other names, payer identifiers and endpoints. Requires at least one of first_name, last_name, organization_name, taxonomy_description or postal_code.",
        "key": "",
        "paginated": false,
        "fields": [
          {
            "name": "count",
            "type": "number"
          },
          {
            "name": "has_more",
            "type": "boolean",
            "about": "True when the page was full; NPPES publishes no total count."
          },
          {
            "name": "limit",
            "type": "number"
          },
          {
            "name": "next_skip",
            "type": "number",
            "about": "skip for the next page, or null at the end or past NPPES's 1200-record depth."
          },
          {
            "name": "observed_at_ms",
            "type": "number",
            "about": "Unix milliseconds when the workflow answered. Every call is live."
          },
          {
            "name": "query",
            "type": "object",
            "about": "The filters as sent, in NPPES vocabulary (enumeration_type NPI-1/NPI-2, upper-case address_purpose), plus limit and skip."
          },
          {
            "name": "results",
            "type": "object[]"
          },
          {
            "name": "skip",
            "type": "number"
          },
          {
            "name": "source_url",
            "type": "string",
            "about": "The exact NPPES API request that answered."
          },
          {
            "name": "warnings",
            "type": "string[]",
            "about": "Non-fatal notes, e.g. a proxy fallback."
          }
        ]
      },
      "example": {
        "request": {
          "city": "New York",
          "limit": 3,
          "state": "NY",
          "taxonomy_description": "Dermatology"
        },
        "response": {
