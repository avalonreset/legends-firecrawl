    {
      "id": "eia-gov/energy-data/data",
      "provider": "eia-gov",
      "capability": "energy-data/data",
      "name": "Data",
      "description": "One page of observations from an EIA route (`<route>/data`) at a frequency, filtered by facet codes and a period range, sorted, with offset pagination up to 5000 rows per page. Each record carries the period, every facet as {code, name}, requested values as source strings, units copied from the source, extra source flags, and the series id when the route has one. Period formats follow the frequency (YYYY, YYYY-Qn, YYYY-MM, YYYY-MM-DD, YYYY-MM-DDTHH).",
      "creditsCost": 5,
      "perRecord": false,
      "options": [
        {
          "name": "api_key",
          "type": "string",
          "in": "body",
          "about": "Registered EIA API key. Omitted, the public data-browser key is discovered live (see `routes`). Pattern: ^[A-Za-z0-9_]+$."
        },
        {
          "name": "cursor",
          "type": "string",
          "in": "body",
          "about": "`next_cursor` from the previous page (a row offset). Omit for the first page. Pattern: ^[0-9]{1,12}$."
        },
        {
          "name": "data_columns",
          "type": "string[]",
          "in": "body",
          "about": "Data columns to return, from the route's `data_columns`. Defaults to [\"value\"]."
        },
        {
          "name": "end",
          "type": "string",
          "in": "body",
          "about": "Inclusive last period in the frequency's format."
        },
        {
          "name": "facets",
          "type": "object",
          "in": "body",
          "about": "Facet filters: facet id to list of codes, e.g. {\"series\": [\"RWTC\"]} or {\"stateid\": [\"CA\"], \"sectorid\": [\"RES\"]}."
        },
        {
          "name": "frequency",
          "type": "string",
          "in": "body",
          "about": "Frequency id from the route metadata: annual, quarterly, monthly, weekly, daily, hourly or local-hourly. Pattern: ^[a-z-]+$.",
          "required": true
        },
        {
          "name": "page_size",
          "type": "number",
          "in": "body",
          "about": "Rows per page; the API caps a page at 5000 rows.",
          "default": 20,
          "min": 1,
          "max": 5000
        },
        {
          "name": "route",
          "type": "string",
          "in": "body",
          "about": "Route path with data, such as `petroleum/pri/spt` (do not append `/data`). Pattern: ^/?[a-z0-9_-]+(/[a-z0-9_-]+)*/?$.",
          "required": true
        },
        {
          "name": "sort",
          "type": "object[]",
          "in": "body",
          "about": "Sort keys applied by the API. Defaults to newest period first."
        },
        {
          "name": "start",
