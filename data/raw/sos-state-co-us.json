{
  "id": "sos-state-co-us",
  "provider": "sos-state-co-us",
  "name": "Colorado Secretary of State business database",
  "description": "Colorado Secretary of State business database (the live registry at www.sos.state.co.us/biz): business name, ID and document-number search, entity summary with periodic report month and registered agent, and the filing history with document links and periodic-report due dates.",
  "toolCount": 3,
  "next": {
    "provider": "firecrawl",
    "capability": "find-tools",
    "options": {
      "level": "tools",
      "limit": 100,
      "offset": 0,
      "providers": [
        "sos-state-co-us"
      ]
    }
  },
  "tools": [
    {
      "id": "sos-state-co-us/entities/entity",
      "provider": "sos-state-co-us",
      "capability": "entities/entity",
      "name": "Entity",
      "description": "You have an entity_id from `search` (or a Colorado SOS ID number) and need the current record.",
      "creditsCost": 3,
      "perRecord": false,
      "options": [
        {
          "name": "entity_id",
          "type": "string",
          "in": "body",
          "about": "11-digit Colorado SOS ID number of a business entity (e.g. 20201707433 for Palantir Technologies Inc.). Trade name and trademark IDs (record_kind other than entity in `search`) are not entities and answer not_found. Pattern: ^[0-9]{11}$.",
          "required": true
        }
      ],
      "response": {
        "about": "Summary of one Colorado business entity by its 11-digit ID number (the site's BusinessEntityDetail page): name (with the site's status suffix such as ', Dissolved December 2, 2018' when present), status, formation date, form (spelled out, e.g. 'Foreign Corporation'), periodic report month, jurisdiction, principal office street and mailing addresses, registered agent name and addresses. Colorado does not publish officers or directors; the filing history (`filings`) links to the filed documents.",
        "key": "",
        "paginated": false,
        "fields": [
          {
            "name": "additional_details",
            "type": "object",
            "about": "Other label/value rows of the summary page's Details table that are not modelled above (e.g. 'Term of duration', 'Delinquent date'), passed through as displayed so nothing the site shows is dropped."
          },
          {
            "name": "entity_id",
            "type": "string",
            "about": "ID number as displayed on the summary page."
          },
          {
            "name": "filings_url",
            "type": "string",
            "about": "The entity's 'Filing history and documents' page (session-bound; use `filings`)."
          },
          {
            "name": "form",
            "type": "string",
            "about": "Entity form as displayed (e.g. 'Foreign Corporation', 'Limited Liability Company')."
          },
          {
            "name": "formation_date",
            "type": "string",
            "about": "Formation date, YYYY-MM-DD; null when the page shows none."
          },
          {
            "name": "jurisdiction",
            "type": "string",
            "about": "Jurisdiction of formation as displayed (e.g. 'Colorado', 'Delaware'); null when not shown."
          },
          {
            "name": "name",
            "type": "string"
          },
          {
            "name": "observed_at_ms",
            "type": "number"
          },
          {
            "name": "periodic_report_month",
            "type": "string",
            "about": "Month the periodic (annual) report is due, as displayed (e.g. 'August'); null when the page shows none (dissolved or withdrawn entities). The exact due date is in `filings` ('Periodic report due by')."
          },
          {
            "name": "principal_office",
            "type": "object"
          },
          {
            "name": "registered_agent",
            "type": "object",
            "about": "Registered agent as displayed; null when the page has no Registered Agent table (typical for dissolved or withdrawn records)."
          },
          {
            "name": "source_url",
            "type": "string"
          },
          {
            "name": "status",
            "type": "string",
            "about": "Status as displayed (e.g. 'Good Standing', 'Delinquent', 'Voluntarily Dissolved', 'Withdrawn')."
          }
        ]
      },
      "example": {
        "request": {
          "entity_id": "20201707433"
        },
        "response": {
          "additional_details": {},
          "entity_id": "20201707433",
          "filings_url": "https://www.sos.state.co.us/biz/BusinessEntityHistory.do?quitButtonDestination=BusinessEntityDetail&pi1=1&nameTyp=ENT&masterFileId=20201707433&entityId2=20201707433&srchTyp=ENTITY",
          "form": "Foreign Corporation",
