    {
      "id": "sos-state-co-us/entities/filings",
      "provider": "sos-state-co-us",
      "capability": "entities/filings",
      "name": "Filings",
      "description": "You need due dates, filed documents or the event timeline for an entity_id from `search` or `entity`.",
      "creditsCost": 5,
      "perRecord": false,
      "options": [
        {
          "name": "entity_id",
          "type": "string",
          "in": "body",
          "about": "11-digit Colorado SOS ID number. Pattern: ^[0-9]{11}$.",
          "required": true
        },
        {
          "name": "page",
          "type": "number",
          "in": "body",
          "about": "1-based history page (about 20 rows per page, oldest first).",
          "default": 1,
          "min": 1,
          "max": 200
        }
      ],
      "response": {
        "about": "Filing history and documents of one Colorado business entity (the site's BusinessEntityHistory page), one page of about 20 rows: event, date filed, date posted, effective date and time, document number with its PDF link (ViewImage.do), and comment. 'Periodic Report due' rows carry the due date in the comment; it is parsed into periodic_report_due, and the latest one on the page into latest_periodic_report_due. Officers are not part of Colorado filings; the PDFs name only the individual causing delivery.",
        "key": "filings",
        "paginated": true,
        "fields": [
          {
            "name": "comment",
            "type": "string",
            "about": "Comment as displayed (e.g. 'Periodic report due by: 10/31/2026', 'Registered Agent Address Change'); null when blank."
          },
          {
            "name": "date_filed",
            "type": "string"
          },
          {
            "name": "date_posted",
            "type": "string"
          },
          {
            "name": "document_id",
            "type": "string",
            "about": "11-digit document number; null for rows without a document (e.g. 'Periodic Report due')."
          },
          {
            "name": "document_url",
            "type": "string",
            "about": "PDF of the filed document (ViewImage.do), fetchable without a session."
          },
          {
            "name": "effective_at",
            "type": "string",
            "about": "Effective date and time as displayed by the site (Mountain Time, no zone), YYYY-MM-DDTHH:MM; date only when the site shows no time."
          },
          {
            "name": "event",
            "type": "string",
            "about": "Event as displayed (e.g. 'Report', 'Periodic Report due', 'Statement of Change', 'Articles of Incorporation')."
          },
          {
            "name": "periodic_report_due",
            "type": "string",
            "about": "Due date parsed from the comment: 'Periodic report due by: MM/DD/YYYY' on current 'Periodic Report due' rows, or 'annual/periodic report due: <date>' on pre-2012 postcard-notification rows; null for other rows."
          }
        ]
      },
