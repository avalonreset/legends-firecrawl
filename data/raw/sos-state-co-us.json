    {
      "id": "sos-state-co-us/entities/search",
      "provider": "sos-state-co-us",
      "capability": "entities/search",
      "name": "Search",
      "description": "Start here to find the 11-digit entity_id for `entity` and `filings`.",
      "creditsCost": 5,
      "perRecord": false,
      "options": [
        {
          "name": "name",
          "type": "string",
          "in": "body",
          "about": "Business name, trade name or trademark text. The site matches names starting with this text, case-insensitive. Very short or common text (e.g. `Denver`) exceeds the site's record cap and fails with invalid_input; refine it.",
          "required": true
        },
        {
          "name": "page",
          "type": "number",
          "in": "body",
          "about": "1-based results page (about 20 rows per page). Each page costs a fresh search session on the site.",
          "default": 1,
          "min": 1,
          "max": 200
        }
      ],
      "response": {
        "about": "Search the Colorado Secretary of State business database by business name, trade name or trademark text (the site's basic search: starts-with, case-insensitive). Returns the results table as displayed: one row per record event (an entity can appear more than once, e.g. its formation document and a later delinquency event), with the 11-digit ID number, document number, name, event, status, form code and formation date, about 20 rows per page. An 11-digit ID or document number is a single-record lookup: pass it to `entity` instead.",
        "key": "results",
        "paginated": true,
        "fields": [
          {
            "name": "document_id",
            "type": "string",
            "about": "11-digit document number of the filing this row describes; null for batch events (e.g. delinquency) that have no document."
          },
          {
            "name": "entity_id",
            "type": "string",
            "about": "11-digit ID number (masterFileId); the key for `entity` and `filings`. For trade names it is the trade name record's ID."
          },
          {
            "name": "event",
            "type": "string",
            "about": "Event as displayed (e.g. 'Articles of Incorporation', 'Statement of Foreign Entity Authority/ Entity Name', 'Batch Event')."
          },
          {
            "name": "form",
            "type": "string",
            "about": "Form code as displayed in the results table (DPC, DLLC, FPC, FLLC, Individual, ...); null when the cell is blank."
          },
          {
            "name": "formation_date",
            "type": "string",
            "about": "Formation date, YYYY-MM-DD; null when blank."
          },
          {
            "name": "name",
            "type": "string",
            "about": "Name as displayed; the site appends status notes such as ', Dissolved December 2, 2018' or ', Delinquent May 1, 2025'."
          },
          {
            "name": "record_kind",
            "type": "string",
            "about": "Derived from the record link: BusinessEntityDetail.do is an entity, TradeNameSummary.do a trade name, a Trademark*.do page a trademark; anything else is other."
          },
          {
            "name": "source_url",
            "type": "string",
            "about": "The record's page on www.sos.state.co.us as linked from the results table."
          },
          {
            "name": "status",
            "type": "string",
            "about": "Status as displayed (e.g. 'Good Standing', 'Delinquent', 'Voluntarily Dissolved', 'Name Changed')."
          }
        ]
      },
      "example": {
        "request": {
          "name": "Palantir"
        },
