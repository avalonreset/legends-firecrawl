      "capability": "statistics/data",
      "name": "Data",
      "description": "Country-year observations for up to 10 indicator codes (from `indicators`), parsed live from the official Excel files: value as source text (null for blank/suppressed cells with the reason in series_note), unit copied from the file, SDMX flag and label, provisional marker, country as ISO3 + M49 + label, file edition and publication date. Filter by ISO3 `countries`, `year_from`/`year_to` and, for arrivals-by-region, `partner` (total | all | UN Tourism region code). Cursor-paginated, deterministic order.",
      "creditsCost": 5,
      "perRecord": false,
      "options": [
        {
          "name": "countries",
          "type": "string[]",
          "in": "body",
          "about": "ISO 3166-1 alpha-3 codes. Omit or empty for every reporter (countries, territories and, in the SDG files, regional aggregates)."
        },
        {
          "name": "cursor",
          "type": "string",
          "in": "body",
          "about": "next_cursor from the previous page of the same query."
        },
        {
          "name": "indicator_codes",
          "type": "string[]",
          "in": "body",
          "about": "Indicator codes such as INBD_TRIP_TOTL_TOTL_TOUR (international tourist arrivals, overnight). Legacy Compendium codes such as CP_1_2 are accepted when a free equivalent exists. Codes spanning more than 3 source files are rejected.",
          "required": true
        },
        {
          "name": "page_size",
          "type": "number",
          "in": "body",
          "about": "page_size",
          "default": 100,
          "min": 1,
          "max": 500
