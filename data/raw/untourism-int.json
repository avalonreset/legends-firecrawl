          "name": "page_size",
          "type": "number",
          "in": "body",
          "about": "page_size",
          "default": 50,
          "min": 1,
          "max": 500
        },
        {
          "name": "query",
          "type": "string",
          "in": "body",
          "about": "Free-text filter: every word must appear in the code, name, legacy code, unit, file id or a built-in synonym (receipts, occupancy, region of origin, mode of transport, departures, nights, employment, tourism gdp); empty lists every indicator."
