      "perRecord": false,
      "options": [
        {
          "name": "cursor",
          "type": "string",
          "in": "body",
          "about": "Continuation returned as next_cursor by the previous page (the servlet's start offset). Pattern: ^[0-9]{1,6}$."
        },
        {
          "name": "function_tag",
          "type": "string",
          "in": "body",
          "about": "Optional Gartner taxonomy tag passed to the servlet's filters parameter, e.g. emt:page/function/cybersecurity, emt:page/function/it, emt:page/theme/artificial-intelligence. Tag ids appear in every returned record's tag_ids. Pattern: ^emt:page/[A-Za-z0-9/_.-]+$."
        },
        {
          "name": "session_type",
          "type": "string",
          "in": "body",
          "about": "Which catalogue to list: upcoming live sessions (default) or the on-demand recordings library.",
          "default": "upcoming",
          "oneOf": [
            "upcoming",
            "on_demand"
          ]
        },
        {
          "name": "start_after",
          "type": "string",
          "in": "body",
          "about": "Optional ISO date (YYYY-MM-DD, UTC). Keeps only webinars starting at or after 00:00 UTC on this day. Applied to the returned page, not upstream; paginate to cover the full window. Pattern: ^[0-9]{4}-[0-9]{2}-[0-9]{2}$."
        },
        {
          "name": "start_before",
          "type": "string",
          "in": "body",
          "about": "Optional ISO date (YYYY-MM-DD, UTC). Keeps only webinars starting before 00:00 UTC on the day after this date (inclusive day). Pattern: ^[0-9]{4}-[0-9]{2}-[0-9]{2}$."
        }
      ],
      "response": {
        "about": "List Gartner webinars from the public webinar catalogue servlet (dynamiccontent, requestType=select-webinars-by-session-type-tags): upcoming or on-demand sessions, optionally filtered by a Gartner taxonomy tag (e.g. emt:page/function/cybersecurity) and by a start-date window applied to the returned page. Each record carries the event and session ids that webinar_detail takes, the detail URL (which is also the registration page), start/end instants in UTC and the site's local time labels.",
        "key": "",
        "paginated": false,
        "fields": [
