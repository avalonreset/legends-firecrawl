    {
      "id": "who-int/indicators/data",
      "provider": "who-int",
      "capability": "indicators/data",
      "name": "Data",
      "description": "Fetch one page of observations for a GHO indicator, filtered by spatial type (COUNTRY, REGION, WORLDBANKINCOMEGROUP, GLOBAL), ISO3/region codes, year range and Dim1/Dim2/Dim3 codes (sex, age group, ...). Each record keeps the source Id, numeric value with low/high bounds as decimal strings, the display string, comments, data source and modification date; source_updated_at is the indicator's newest modification date. Unknown indicator codes fail with not_found.",
      "creditsCost": 5,
      "perRecord": false,
      "options": [
        {
          "name": "cursor",
          "type": "string",
          "in": "body",
          "about": "next_cursor from the previous page of the same filters and page_size."
        },
        {
          "name": "dim1",
          "type": "string[]",
          "in": "body",
          "about": "Dim1 value codes, e.g. SEX_FMLE or AGEGROUP_YEARS0-4."
        },
        {
          "name": "dim2",
          "type": "string[]",
          "in": "body",
          "about": "dim2"
        },
        {
          "name": "dim3",
          "type": "string[]",
          "in": "body",
          "about": "dim3"
        },
        {
          "name": "indicator_code",
          "type": "string",
          "in": "body",
          "about": "GHO indicator code, e.g. WHOSIS_000001 (life expectancy at birth) or MDG_0000000001 (infant mortality rate). Pattern: ^[A-Za-z0-9_.+-]{1,64}$.",
          "required": true
        },
        {
          "name": "page_size",
          "type": "number",
          "in": "body",
          "about": "Rows per page; the GHO server caps $top at 1000.",
          "default": 100,
          "min": 1,
          "max": 1000
        },
        {
          "name": "spatial_dim_type",
          "type": "string",
          "in": "body",
          "about": "Restrict to one spatial level. Omit for all levels; spatial_dim_type on each record says which.",
          "oneOf": [
            "COUNTRY",
            "REGION",
            "WORLDBANKINCOMEGROUP",
            "GLOBAL",
            "null"
          ]
        },
        {
          "name": "spatial_dims",
          "type": "string[]",
          "in": "body",
          "about": "ISO3 country codes (BRA), WHO region codes (AFR), income-group codes (WB_HI) or GLOBAL."
        },
        {
          "name": "time_from",
          "type": "number",
          "in": "body",
          "about": "Inclusive first year (TimeDim ge).",
          "min": 1000,
          "max": 9999
        },
        {
          "name": "time_to",
          "type": "number",
          "in": "body",
          "about": "Inclusive last year (TimeDim le).",
          "min": 1000,
          "max": 9999
        }
      ],
      "response": {
        "about": "Fetch one page of observations for a GHO indicator, filtered by spatial type (COUNTRY, REGION, WORLDBANKINCOMEGROUP, GLOBAL), ISO3/region codes, year range and Dim1/Dim2/Dim3 codes (sex, age group, ...). Each record keeps the source Id, numeric value with low/high bounds as decimal strings, the display string, comments, data source and modification date; source_updated_at is the indicator's newest modification date. Unknown indicator codes fail with not_found.",
        "key": "",
        "paginated": false,
        "fields": [
          {
            "name": "complete",
            "type": "boolean"
          },
          {
            "name": "indicator",
            "type": "object"
          },
          {
            "name": "license",
            "type": "object",
            "about": "Source-defined WHO metadata."
          },
          {
            "name": "next_cursor",
            "type": "string"
          },
          {
