    {
      "id": "etsy-com/listings/listing",
      "provider": "etsy-com",
      "capability": "listings/listing",
      "name": "Listing",
      "description": "You have a listing id or an etsy.com/listing/{id}/ URL. Use similar_listings for discovery, listing_variations for option prices, shop_sections for the seller's sections.",
      "creditsCost": 5,
      "perRecord": false,
      "options": [
        {
          "name": "currency",
          "type": "string",
          "in": "body",
          "about": "Currency the listing price is returned in (Etsy's x-detected-locale). price_usd is always returned as well.",
          "default": "USD",
          "oneOf": [
            "USD",
            "GBP",
            "EUR"
          ]
        },
        {
          "name": "listing_id",
          "type": "number",
          "in": "body",
          "about": "Numeric Etsy listing id (the number after /listing/ in a listing URL).",
          "min": 1
        },
        {
          "name": "url",
          "type": "string",
          "in": "body",
          "about": "An etsy.com listing URL: https://www.etsy.com/listing/{id}/..., a regional /uk/listing/{id}/ form or a {shop}.etsy.com/listing/{id} storefront URL."
