        {
          "name": "include_scores",
          "type": "boolean",
          "in": "body",
          "about": "Embed the shaped match card under `match`; false returns the index only."
        },
        {
          "name": "round",
          "type": "string",
          "in": "body",
          "about": "FNL, SFNL, QFNL, 8FNL, R32, R64, R128, RND1, RND2, RND3 or GP (any group; GP01.. for one group)."
