    {
      "id": "uhaul-com/truck-rentals/get_location_reviews",
      "provider": "uhaul-com",
      "capability": "truck-rentals/get_location_reviews",
      "name": "Get location reviews",
      "description": "You have a location `entity_id` and want its customer feedback.",
      "creditsCost": 5,
      "perRecord": false,
      "options": [
        {
          "name": "entity_id",
          "type": "string",
          "in": "body",
          "about": "Numeric U-Haul location id, padded (`002131`) or not (`2131`). Pattern: ^[0-9]{1,9}$.",
          "required": true
        },
        {
          "name": "limit",
          "type": "number",
          "in": "body",
          "about": "Reviews per page.",
          "default": 20,
          "min": 1,
          "max": 100
        },
        {
          "name": "offset",
          "type": "number",
          "in": "body",
          "about": "Index of the first review to return.",
          "default": 0,
          "min": 0
        }
      ],
      "response": {
        "about": "Customer reviews of one U-Haul location: aggregate rating and the reviews the reviews page embeds (up to 100, newest first) with author, date, text and star rating, paged by offset/limit.",
        "key": "reviews",
        "paginated": true,
        "fields": [
          {
            "name": "author",
            "type": "string",
            "about": "Reviewer name as the site publishes it (first name and initial)."
          },
          {
            "name": "best_rating",
            "type": "number"
          },
          {
            "name": "body",
            "type": "string"
          },
          {
            "name": "date",
            "type": "string",
            "about": "ISO date."
          },
          {
            "name": "rating",
            "type": "number"
          }
        ]
      },
      "example": {
        "request": {
          "entity_id": "002131",
          "limit": 5
        },
        "response": {
          "count": 5,
          "entity_id": "002131",
          "inline_total": 100,
          "name": "Westside Rentals Inc",
          "next_offset": 5,
          "observed_at_ms": 1790023443156,
          "offset": 0,
          "rating": {
            "count": 169,
            "value": 2.5
          },
          "reviews": [
            {
              "author": "JOAQUINA R",
              "best_rating": 5,
              "body": "I think what needs to be improved is pricing that $19.95 is literally a scam, I paid $130 and an extra $22 for gas just for a couple of miles to move some furniture… smh",
              "date": "2026-09-09",
              "rating": 1
            },
            {
              "author": "Lamont H",
              "best_rating": 5,
              "body": "The drop-off was closed and the location is off property. Had to leave equipment outside",
              "date": "2026-06-01",
              "rating": 2
            },
            {
              "author": "Nathan K",
              "best_rating": 5,
              "body": "I recently used your service for the first time, and unfortunately, it was a very disappointing experience. The truck was returned with less than a quarter tank of fuel and was not clean. Additionally, when I contacted customer service, I was told that a discount would be provided, but I never received it. Overall, I feel that I was told what I wanted to hear, but there was no follow-through. I would appreciate it if someone could look into this and provide a resolution",
              "date": "2026-04-22",
              "rating": 1
            },
            {
              "author": "Gilbert B",
              "best_rating": 5,
              "body": "Increase parking space at this location",
              "date": "2026-04-06",
              "rating": 4
            },
            {
              "author": "JAMES P",
              "best_rating": 5,
              "body": null,
              "date": "2026-01-22",
              "rating": 2
            }
          ],
          "source_url": "https://www.uhaul.com/Locations/Customer-reviews-for-Location/002131/",
          "url": "https://www.uhaul.com/Locations/Customer-reviews-for-Location/002131/"
        },
        "recordedAt": "2026-09-21"
      },
      "execute": {
        "provider": "uhaul-com",
        "capability": "truck-rentals/get_location_reviews"
      }
